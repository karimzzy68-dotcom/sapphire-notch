<Window x:Class="SapphireNotch.Windows.HubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SapphireNotch.Windows"
        Title="Sapphire NOTCh" Width="1100" Height="740" MinWidth="880" MinHeight="560"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Ink}">

    <Window.Resources>
        <LinearGradientBrush x:Key="HubCard" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2EFFFFFF" Offset="0"/>
            <GradientStop Color="#12FFFFFF" Offset="0.1"/>
            <GradientStop Color="#0AFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="HubLine" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="HubField" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="HubSide" Color="#C7CAD0"/>

        <!-- Sidebar entry: icon + label, soft rounded highlight when selected (same as SettingsWindow) -->
        <Style x:Key="HubItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource HubSide}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="GroupName" Value="hubnav"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="9" Background="Transparent" Padding="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,11,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassSelected}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HubGroup" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Dim3}"/>
            <Setter Property="Margin" Value="10,16,0,6"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Dim3}"/>
        </Style>

        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HubCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HubLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22,18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="PageSub" TargetType="TextBlock" BasedOn="{StaticResource Sub}">
            <Setter Property="Margin" Value="0,4,0,20"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="RowDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="Page" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <!-- Margin keeps the scroll bar clear of the panel's rounded corners -->
            <Setter Property="Margin" Value="0,10,6,10"/>
            <Setter Property="Padding" Value="30,16,20,14"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <!-- Rounded field holding a TextBox and its placeholder -->
        <Style x:Key="Field" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HubField}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HubLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dim3}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <!-- Multi-line text area with a visible scroll bar (the app-wide TextBox hides it) -->
        <Style x:Key="Editor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HubIcon" TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource HubSide}"/>
            <Setter Property="local:Round.Radius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HubButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="local:Round.Radius" Value="10"/>
        </Style>

        <Style x:Key="HubAccent" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="local:Round.Radius" Value="10"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource HubButton}">
            <Setter Property="Background" Value="#24F4505E"/>
            <Setter Property="Foreground" Value="#FF8D97"/>
        </Style>

        <!-- Writing style choice card -->
        <Style x:Key="StyleCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="GroupName" Value="hubstyle"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource HubCard}" BorderBrush="{StaticResource HubLine}" BorderThickness="1.5"
                                CornerRadius="16" Padding="18,14">
                            <DockPanel>
                                <Border x:Name="Dot" DockPanel.Dock="Right" Width="17" Height="17" CornerRadius="9" VerticalAlignment="Top"
                                        BorderBrush="#5A5F68" BorderThickness="1.5" Margin="10,1,0,0"/>
                                <ContentPresenter/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Orange}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassSelected}"/>
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource Orange}"/>
                                <Setter TargetName="Dot" Property="BorderThickness" Value="5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim glass scroll bar for every ScrollViewer in the hub -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb MinHeight="28">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#38FFFFFF" Margin="1,2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoteItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="HistoryRow">
            <Border Background="{StaticResource HubCard}" BorderBrush="{StaticResource HubLine}" BorderThickness="1"
                    CornerRadius="14" Padding="16,12,12,12" Margin="0,0,0,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource HubIcon}" VerticalAlignment="Top" Tag="{Binding}"
                            ToolTip="Copy text" Click="CopyEntry_Click">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13"/>
                    </Button>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding Text}" FontSize="13.5" TextWrapping="Wrap" TextTrimming="None" LineHeight="20"/>
                        <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource Dim3}" Margin="0,6,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NoteRow">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Medium"/>
                <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource Dim3}" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="WordChip">
            <Border Background="{StaticResource HubField}" BorderBrush="{StaticResource HubLine}" BorderThickness="1"
                    CornerRadius="15" Padding="12,0,4,0" Height="30" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource HubIcon}" Width="22" Height="22" Margin="6,0,0,0" Background="Transparent"
                            local:Round.Radius="11" Tag="{Binding}" ToolTip="Remove" Click="RemoveWord_Click">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="9"/>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SnippetRow">
            <Border Background="{StaticResource HubCard}" BorderBrush="{StaticResource HubLine}" BorderThickness="1"
                    CornerRadius="14" Padding="16,12,12,12" Margin="0,0,0,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource HubIcon}" Tag="{Binding}" ToolTip="Edit" Click="EditSnippet_Click">
                            <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="13"/>
                        </Button>
                        <Button Style="{StaticResource HubIcon}" Margin="6,0,0,0" Tag="{Binding}" ToolTip="Delete" Click="DeleteSnippet_Click">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <Border Background="#1AFFFFFF" CornerRadius="7" Padding="9,3" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Trigger}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"/>
                        </Border>
                        <TextBlock Text="{Binding Expansion}" FontSize="13" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                                   TextTrimming="None" Margin="2,8,0,0" LineHeight="19"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Darkens the acrylic so text stays readable over any wallpaper -->
    <Grid Background="#A6050608">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Grid.Column="0" Margin="12,18,12,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom">
                <Border Background="#0DFFFFFF" CornerRadius="11" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Dim4}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Dictation is off" Foreground="{StaticResource Dim}" FontSize="12.5"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Sapphire NOTCh 1.0" Foreground="{StaticResource Dim3}" FontSize="12" Margin="12,10,0,0"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Sapphire" FontSize="18" FontWeight="Medium" Margin="10,4,0,6"/>

                <TextBlock Text="FLOW" Style="{StaticResource HubGroup}"/>
                <RadioButton x:Name="NavDictation" Content="Dictation" Tag="&#xE720;" Style="{StaticResource HubItem}" IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavNotes" Content="Notetaker" Tag="&#xE70B;" Style="{StaticResource HubItem}" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavStats" Content="Statistics" Tag="&#xE9D2;" Style="{StaticResource HubItem}" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavDictionary" Content="Dictionary" Tag="&#xE82D;" Style="{StaticResource HubItem}" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSnippets" Content="Snippets" Tag="&#xE945;" Style="{StaticResource HubItem}" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavStyles" Content="Styles" Tag="&#xE8D2;" Style="{StaticResource HubItem}" Checked="Nav_Checked"/>

                <TextBlock Text="APP" Style="{StaticResource HubGroup}"/>
                <RadioButton x:Name="NavSettings" Content="Settings" Tag="&#xE713;" Style="{StaticResource HubItem}" Checked="Nav_Checked"/>
            </StackPanel>
        </DockPanel>

        <!-- Main panel -->
        <Border Grid.Column="1" Margin="0,12,12,12" Background="#B30E0F12" CornerRadius="22"
                BorderBrush="{StaticResource HubLine}" BorderThickness="1">
            <Grid>
                <!-- DICTATION -->
                <ScrollViewer x:Name="PageDictation" Style="{StaticResource Page}" Visibility="Visible">
                    <StackPanel>
                        <Border Style="{StaticResource Section}" Padding="30,26">
                            <StackPanel>
                                <TextBlock Text="Hello" FontSize="36" FontWeight="Medium"/>
                                <TextBlock Text="Hold your dictation key anywhere, speak, let go: your words are typed where the cursor is."
                                           Style="{StaticResource Sub}" FontSize="14" Margin="0,6,0,18" TextWrapping="Wrap" TextTrimming="None"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource HubAccent}" Click="TakeNotes_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource OnOrange}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Take call notes" Foreground="{StaticResource OnOrange}" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="Dictate anywhere on your computer" FontSize="17" FontWeight="Medium"/>
                                <TextBlock Text="Speak in any app and Sapphire types for you, in the style you pick, with your words and snippets."
                                           Style="{StaticResource Sub}" Margin="0,6,0,16" TextWrapping="Wrap" TextTrimming="None"/>
                                <DockPanel Margin="0,0,0,16">
                                    <ToggleButton x:Name="TglDictation" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                  Click="DictationSwitch_Click"/>
                                    <TextBlock Text="Turn on dictation" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="#24F5A524" CornerRadius="11" Padding="10,3" VerticalAlignment="Center">
                                        <TextBlock Text="Not connected" FontSize="12" FontWeight="Medium" Foreground="#FBC06A"/>
                                    </Border>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Speech engine, on your computer" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="Runs offline. Nothing is sent anywhere; new dictations land in your history below."
                                                   Style="{StaticResource RowDetail}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Field}" Width="240">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource Dim3}" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="HistorySearchHint" Grid.Column="1" Text="Search dictations" Style="{StaticResource Placeholder}"/>
                                            <TextBox x:Name="HistorySearch" Grid.Column="1" TextChanged="HistorySearch_TextChanged"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="HISTORY" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </DockPanel>

                                <StackPanel x:Name="HistoryEmpty" DockPanel.Dock="Top" Margin="0,36,0,24" HorizontalAlignment="Center">
                                    <TextBlock x:Name="HistoryEmptyText" Text="Your dictations will show here. Hold your dictation key in any app and speak."
                                               Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" MaxWidth="380"/>
                                    <StackPanel x:Name="SamplePanel" HorizontalAlignment="Center" Margin="0,16,0,0">
                                        <Button Content="Add sample dictation" Style="{StaticResource HubButton}" HorizontalAlignment="Center" Click="AddSample_Click"/>
                                        <TextBlock Text="Sample data, to preview the hub. Clear it in Settings."
                                                   Style="{StaticResource Caption}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <ItemsControl x:Name="HistoryList" ItemTemplate="{StaticResource HistoryRow}"/>
                            </DockPanel>

                            <Border Grid.Column="2" Style="{StaticResource Section}" VerticalAlignment="Top" Padding="22,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                        <TextBlock x:Name="DTotal" Text="0" FontSize="32" FontWeight="Medium" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="words dictated" Style="{StaticResource Sub}" FontSize="14" Margin="10,0,0,6" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock x:Name="DWpm" Text="0" FontSize="32" FontWeight="Medium" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="words/min" Style="{StaticResource Sub}" FontSize="14" Margin="10,0,0,6" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock x:Name="DStreak" Text="0" FontSize="32" FontWeight="Medium" VerticalAlignment="Bottom"/>
                                        <TextBlock x:Name="DStreakLabel" Text="days in a row" Style="{StaticResource Sub}" FontSize="14" Margin="10,0,0,6" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock x:Name="DToday" Text="0" FontSize="32" FontWeight="Medium" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="words today" Style="{StaticResource Sub}" FontSize="14" Margin="10,0,0,6" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <Border Height="1" Background="{StaticResource HubLine}" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource Green2}" Margin="0,0,9,0"/>
                                        <TextBlock Text="Stored only on this PC" Foreground="{StaticResource Green2}" FontSize="13.5" FontWeight="Medium"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- NOTETAKER -->
                <Grid x:Name="PageNotes" Visibility="Collapsed" Margin="30,26,26,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource HubAccent}" VerticalAlignment="Top" Click="NewNote_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Foreground="{StaticResource OnOrange}" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="New note" Foreground="{StaticResource OnOrange}" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Notetaker" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Quick notes, saved as you type. The first line is the title." Style="{StaticResource PageSub}"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Section}" Padding="8" Margin="0">
                            <Grid>
                                <ListBox x:Name="NoteList" Background="Transparent" BorderThickness="0" Padding="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource NoteItem}" ItemTemplate="{StaticResource NoteRow}"
                                         SelectionChanged="NoteList_SelectionChanged"/>
                                <TextBlock x:Name="NotesEmpty" Text="No notes yet." Style="{StaticResource Sub}" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,24,0,0"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Section}" Margin="0" Padding="22,16,16,16">
                            <Grid>
                                <DockPanel x:Name="NoteEditorPanel">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource HubIcon}" ToolTip="Delete note" Click="DeleteNote_Click">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13"/>
                                        </Button>
                                        <TextBlock x:Name="NoteMeta" Text="0 words" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Border Height="1" DockPanel.Dock="Top" Background="{StaticResource HubLine}" Margin="0,0,6,12"/>
                                    <TextBox x:Name="NoteEditor" Style="{StaticResource Editor}" FontSize="14" TextChanged="NoteEditor_TextChanged"/>
                                </DockPanel>
                                <TextBlock x:Name="NoteEditorEmpty" Text="Select a note, or create one with New note." Style="{StaticResource Sub}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- STATISTICS -->
                <ScrollViewer x:Name="PageStats" Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="Statistics" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="How much you dictate, how fast, and how often." Style="{StaticResource PageSub}"/>
                        <UniformGrid Columns="4" Margin="0,0,-12,0">
                            <Border Style="{StaticResource Section}" Margin="0,0,12,16">
                                <StackPanel>
                                    <TextBlock x:Name="STotal" Text="0" FontSize="34" FontWeight="Medium"/>
                                    <TextBlock Text="words dictated" Style="{StaticResource Sub}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Section}" Margin="0,0,12,16">
                                <StackPanel>
                                    <TextBlock x:Name="SWpm" Text="0" FontSize="34" FontWeight="Medium"/>
                                    <TextBlock Text="words per minute" Style="{StaticResource Sub}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Section}" Margin="0,0,12,16">
                                <StackPanel>
                                    <TextBlock x:Name="SStreak" Text="0" FontSize="34" FontWeight="Medium"/>
                                    <TextBlock Text="days in a row" Style="{StaticResource Sub}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Section}" Margin="0,0,12,16">
                                <StackPanel>
                                    <TextBlock x:Name="SToday" Text="0" FontSize="34" FontWeight="Medium"/>
                                    <TextBlock Text="words today" Style="{StaticResource Sub}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource Orange}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Today" Style="{StaticResource Caption}" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,14,0"/>
                                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#8CFB923C" Margin="0,0,6,0"/>
                                        <TextBlock Text="Earlier days" Style="{StaticResource Caption}" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,14,0"/>
                                        <Line X1="0" Y1="5" X2="16" Y2="5" Stroke="{StaticResource Dim}" StrokeThickness="1.2" StrokeDashArray="3,2"
                                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Daily average" Style="{StaticResource Caption}" FontSize="12" Foreground="{StaticResource Dim}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Words per day" FontSize="15" FontWeight="Medium"/>
                                        <TextBlock Text="Last 14 days" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border x:Name="ChartHost" Height="250" SizeChanged="ChartHost_SizeChanged">
                                    <Canvas x:Name="ChartCanvas" ClipToBounds="False"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <UniformGrid Columns="3">
                                <StackPanel>
                                    <TextBlock Text="ENTRIES" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="SEntries" Text="0" FontSize="18" FontWeight="Medium" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="BUSIEST DAY (14 DAYS)" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="SBest" Text="None yet" FontSize="18" FontWeight="Medium" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="TIME SPEAKING" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="STime" Text="0 min" FontSize="18" FontWeight="Medium" Margin="0,4,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- DICTIONARY -->
                <ScrollViewer x:Name="PageDictionary" Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="Dictionary" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Names, brands and jargon. Dictations are corrected to the exact spelling you save here."
                                   Style="{StaticResource PageSub}"/>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource HubAccent}" Margin="10,0,0,0" Click="AddWord_Click"/>
                                    <Border Style="{StaticResource Field}">
                                        <Grid>
                                            <TextBlock x:Name="WordInputHint" Text="Add a word or phrase, like Kubernetes or Dr. Okafor" Style="{StaticResource Placeholder}"/>
                                            <TextBox x:Name="WordInput" KeyDown="WordInput_KeyDown" TextChanged="WordInput_TextChanged"/>
                                        </Grid>
                                    </Border>
                                </DockPanel>
                                <TextBlock x:Name="WordMessage" Style="{StaticResource Caption}" FontSize="12" Foreground="{StaticResource Amber}"
                                           Margin="2,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,4,0,12">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Field}" Width="240">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource Dim3}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="WordSearchHint" Grid.Column="1" Text="Search words" Style="{StaticResource Placeholder}"/>
                                    <TextBox x:Name="WordSearch" Grid.Column="1" TextChanged="WordSearch_TextChanged"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="WordCount" Text="YOUR WORDS" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </DockPanel>
                        <TextBlock x:Name="WordsEmpty" Text="No custom words yet." Style="{StaticResource Sub}" Margin="2,8,0,0"/>
                        <ItemsControl x:Name="WordList" ItemTemplate="{StaticResource WordChip}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- SNIPPETS -->
                <ScrollViewer x:Name="PageSnippets" Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="Snippets" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Say a trigger phrase and Sapphire types the full text instead."
                                   Style="{StaticResource PageSub}"/>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock x:Name="SnippetFormTitle" Text="New snippet" FontSize="15" FontWeight="Medium" Margin="0,0,0,12"/>
                                <TextBlock Text="When I say" Style="{StaticResource Caption}" FontSize="12" Foreground="{StaticResource Dim}" Margin="2,0,0,6"/>
                                <Border Style="{StaticResource Field}" Margin="0,0,0,12">
                                    <Grid>
                                        <TextBlock x:Name="TriggerHint" Text="e.g. my address" Style="{StaticResource Placeholder}"/>
                                        <TextBox x:Name="TriggerInput" TextChanged="SnippetInput_TextChanged"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Type this" Style="{StaticResource Caption}" FontSize="12" Foreground="{StaticResource Dim}" Margin="2,0,0,6"/>
                                <Border Style="{StaticResource Field}" Padding="11,8" Height="88" Margin="0,0,0,14">
                                    <Grid>
                                        <TextBlock x:Name="ExpansionHint" Text="e.g. 12 Harbour Street, Leeds LS1 4AB" Style="{StaticResource Placeholder}" VerticalAlignment="Top"/>
                                        <TextBox x:Name="ExpansionInput" Style="{StaticResource Editor}" FontSize="13" TextChanged="SnippetInput_TextChanged"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="SaveSnippetButton" Content="Add snippet" Style="{StaticResource HubAccent}" Click="SaveSnippet_Click"/>
                                    <Button x:Name="CancelSnippetButton" Content="Cancel" Style="{StaticResource HubButton}" Margin="8,0,0,0"
                                            Visibility="Collapsed" Click="CancelSnippet_Click"/>
                                    <TextBlock x:Name="SnippetMessage" Style="{StaticResource Caption}" FontSize="12" Foreground="{StaticResource Amber}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SnippetCount" Text="YOUR SNIPPETS" Style="{StaticResource Label}" Margin="2,4,0,12"/>
                        <TextBlock x:Name="SnippetsEmpty" Text="No snippets yet." Style="{StaticResource Sub}" Margin="2,0,0,0"/>
                        <ItemsControl x:Name="SnippetList" ItemTemplate="{StaticResource SnippetRow}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- STYLES -->
                <ScrollViewer x:Name="PageStyles" Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="Styles" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Choose how your dictations are written out. Filler words are removed in every style except Raw."
                                   Style="{StaticResource PageSub}"/>
                        <UniformGrid Columns="2" Margin="0,0,-12,4">
                            <RadioButton x:Name="StyleCasual" Tag="Casual" Style="{StaticResource StyleCard}" Checked="Style_Checked">
                                <StackPanel>
                                    <TextBlock Text="Casual" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="Contractions, no final full stop. For chat and quick replies." Style="{StaticResource RowDetail}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="StyleFormal" Tag="Formal" Style="{StaticResource StyleCard}" Checked="Style_Checked">
                                <StackPanel>
                                    <TextBlock Text="Formal" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="Full words, capitalised sentences, closing punctuation. For email and documents." Style="{StaticResource RowDetail}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="StyleBullets" Tag="Bullets" Style="{StaticResource StyleCard}" Checked="Style_Checked">
                                <StackPanel>
                                    <TextBlock Text="Bullet points" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="One bullet per sentence. For lists, notes and to-dos." Style="{StaticResource RowDetail}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="StyleRaw" Tag="Raw" Style="{StaticResource StyleCard}" Checked="Style_Checked">
                                <StackPanel>
                                    <TextBlock Text="Raw" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="Exactly what the speech engine heard, untouched." Style="{StaticResource RowDetail}"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="Preview" FontSize="15" FontWeight="Medium" Margin="0,0,0,12"/>
                                <TextBlock Text="YOU SAY" Style="{StaticResource Label}" Margin="2,0,0,6"/>
                                <Border Style="{StaticResource Field}" Padding="11,8" Height="76" Margin="0,0,0,16">
                                    <TextBox x:Name="PreviewInput" Style="{StaticResource Editor}" FontSize="13.5" TextChanged="PreviewInput_TextChanged"
                                             Text="Um, I think we should not ship the update today. It is not ready yet and the tests are failing. Can you check the logs and let me know what you find?"/>
                                </Border>
                                <TextBlock x:Name="PreviewLabel" Text="SAPPHIRE TYPES" Style="{StaticResource Label}" Margin="2,0,0,6"/>
                                <Border Background="#0AFFFFFF" BorderBrush="{StaticResource HubLine}" BorderThickness="1" CornerRadius="10" Padding="13,10" MinHeight="76">
                                    <TextBlock x:Name="PreviewOutput" FontSize="13.5" TextWrapping="Wrap" TextTrimming="None" LineHeight="21"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- SETTINGS -->
                <ScrollViewer x:Name="PageSettings" Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Dictation, the notch, and where your data lives." Style="{StaticResource PageSub}"/>

                        <TextBlock Text="DICTATION" Style="{StaticResource Label}" Margin="2,0,0,10"/>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <ToggleButton x:Name="TglDictation2" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="DictationSwitch_Click"/>
                                    <TextBlock Text="Turn on dictation" Style="{StaticResource RowLabel}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <ToggleButton x:Name="TglUseDictionary" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="DictationOptions_Click"/>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Fix spelling with my dictionary" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="Rewrites saved words with their exact spelling." Style="{StaticResource RowDetail}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel>
                                    <ToggleButton x:Name="TglSnippets" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="DictationOptions_Click"/>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Expand snippets" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="Replaces trigger phrases with their full text." Style="{StaticResource RowDetail}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="NOTCH" Style="{StaticResource Label}" Margin="2,4,0,10"/>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <ToggleButton x:Name="TglHover" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="General_Toggled"/>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Open on hover" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="When off, click the notch to open it." Style="{StaticResource RowDetail}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="Close5" Tag="5" Content="5s" Style="{StaticResource SegButton}" FontSize="12.5" Click="Close_Click"/>
                                        <Button x:Name="Close15" Tag="15" Content="15s" Style="{StaticResource SegButton}" FontSize="12.5" Click="Close_Click"/>
                                        <Button x:Name="Close30" Tag="30" Content="30s" Style="{StaticResource SegButton}" FontSize="12.5" Click="Close_Click" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock Text="Close after the pointer leaves" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel>
                                    <ToggleButton x:Name="TglStartup" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="General_Toggled"/>
                                    <TextBlock Text="Start with Windows" Style="{StaticResource RowLabel}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="NOTCH TABS" Style="{StaticResource Label}" Margin="2,4,0,10"/>
                        <Border Style="{StaticResource Section}">
                            <UniformGrid Columns="2">
                                <DockPanel Margin="0,0,24,14">
                                    <ToggleButton x:Name="TglMusic" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Tab_Toggled"/>
                                    <TextBlock Text="Music" Style="{StaticResource RowLabel}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <ToggleButton x:Name="TglDev" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Tab_Toggled"/>
                                    <TextBlock Text="Developer" Style="{StaticResource RowLabel}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,24,14">
                                    <ToggleButton x:Name="TglShare" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Tab_Toggled"/>
                                    <TextBlock Text="Nearby Share" Style="{StaticResource RowLabel}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <ToggleButton x:Name="TglTools" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Tab_Toggled"/>
                                    <TextBlock Text="Tools" Style="{StaticResource RowLabel}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,24,0">
                                    <ToggleButton x:Name="TglSystem" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Tab_Toggled"/>
                                    <TextBlock Text="System usage" Style="{StaticResource RowLabel}"/>
                                </DockPanel>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="DATA" Style="{StaticResource Label}" Margin="2,4,0,10"/>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="History, notes, dictionary and snippets are stored here:" Style="{StaticResource RowDetail}" Margin="0"/>
                                <TextBlock x:Name="DataPath" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,14"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Open folder" Style="{StaticResource HubButton}" Click="OpenFolder_Click"/>
                                    <Button Content="Clear history" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="ClearHistory_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
